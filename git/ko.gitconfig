# kosetup git config — wired in via `git config --global include.path` by install.sh.
# Identity ([user] name/email) stays per-machine in ~/.gitconfig itself.

# Work identity override for work-repo dirs (create ~/.gitconfig.work with the
# work [user] block on work machines; silently ignored when the file is absent).
# Both layouts matched: ~/rpc/repo/ (old Devuan box) and ~/Work/rpc/ (omarchy).
[includeIf "gitdir:~/rpc/repo/"]
	path = ~/.gitconfig.work
[includeIf "gitdir:~/Work/rpc/"]
	path = ~/.gitconfig.work

[core]
	autocrlf = false

[alias]
	# st/co/br/ci are also in omarchy's own global config, with byte-identical
	# values — so defining them here is a no-op there, and is what supplies
	# them on machines WITHOUT omarchy (the Devuan box). Keep them in sync if
	# omarchy ever changes its versions: this file is included last, so it wins.
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold yellow)%h%C(reset) - %C(dim white)%s%C(reset)%C(auto)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold yellow)%h%C(reset) - %C(dim white)%s%C(reset) %C(bold green)- %an%C(reset) %C(dim bold green)(%ar)%C(reset)%C(auto)%d%C(reset)' --all
	lgf = diff-tree --no-commit-id --name-only -r
