#!/usr/bin/env bash
# sys-tile — compact system tile in Matrix Vivid phosphor green.
# One line per metric with an inline gauge: cpu, mem, gpu, gpu-fan, battery.
# GPU fan RPM comes from the ASUS hwmon (nvidia-smi reports N/A on this laptop).
#
# Usage: sys-tile [-l|--top-left] [interval_seconds]   (default: centered, 1s)
#   -l, --top-left   anchor at top-left instead of centering
#   TILE_CENTER=0    env equivalent of --top-left

set -u

# --- args ---
CENTER=1; INTERVAL=1
[ -n "${TILE_CENTER:-}" ] && CENTER=$TILE_CENTER
for a in "$@"; do
  case "$a" in
    -c|--center)   CENTER=1 ;;
    -l|--top-left) CENTER=0 ;;
    -h|--help)     sed -n '2,9p' "$0"; exit 0 ;;
    ''|*[!0-9.]*)  ;;
    *)             INTERVAL=$a ;;
  esac
done
FAN_MAX="${GPU_FAN_MAX:-6000}"
DISK="${SYS_DISK:-/}"             # filesystem shown in the disk preset
VBW=4; VBH=7; HGW=10; GAP="   "   # vertical-bar width/height, horiz gauge width, column gap
SW=12                             # fixed wifi status width (fits "disconnected"); SSID truncated to it

# --- palette — custom Matrix Vivid truecolor green by default; the 'c' key toggles ANSI-ride mode
#     (16-colour, follows the active terminal preset; see ~/repo/ANSI-Themes). Per-session toggle. ---
R=$'\e[0m'
# OSC: custom mode forces the Matrix Vivid base (green-on-black) so it doesn't sit on the preset's bg;
# ride modes lift it (terminal default) so the tile follows the active preset. Reset on exit (see cleanup).
BGON=$'\e]11;#000000\a'; FGON=$'\e]10;#33ff33\a'; BGOFF=$'\e]111\a'; FGOFF=$'\e]110\a'
mode=0   # theme: 0 custom truecolor green · 1 ride-accent (blue slot 4/12 = scheme signature) · 2 ride-green (slot 2/10). 'c' cycles.
set_palette() {   # set tiers (P bright / A accent / D dim+track) from $mode.
  # Ride modes honour the brightness/"opacity" tiers: ONE slot hue modulated by bold/bright/normal/faint
  # so the gradient survives. Accent (slot 4) is each scheme's signature — purple on Dracula, blue on
  # Win95/GitHub, spring-green on Matrix Vivid; green (slot 2) keeps the phosphor feel.
  case $mode in
    1) P=$'\e[1;94m'; A=$'\e[94m'; D=$'\e[34m' ;;
    2) P=$'\e[1;92m'; A=$'\e[92m'; D=$'\e[32m' ;;
    *) P=$'\e[38;2;95;255;143m'; A=$'\e[38;2;51;255;51m'; D=$'\e[38;2;67;144;79m' ;;
  esac
  if (( mode )); then printf '%s%s' "$FGOFF" "$BGOFF"   # ride: follow the preset (lift forced bg/fg)
  else printf '%s%s' "$FGON" "$BGON"; fi                 # custom: force Matrix Vivid green-on-black
}
set_palette
HIDE=$'\e[?25l'; SHOW=$'\e[?25h'; HOME=$'\e[H'; CLR=$'\e[2J'; EOL=$'\e[K'; CLREOS=$'\e[J'

cleanup() { printf '%s%s%s%s%s%s' "$R" "$FGOFF" "$BGOFF" "$CLR" "$HOME" "$SHOW"; }   # reset (incl. forced bg/fg), clear, home, show cursor
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

resolve_fan() {
  local h lf f
  # 1st choice: the ASUS hwmon's gpu_fan (the ROG laptop this tile grew up on)
  for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "asus" ] || continue
    for lf in "$h"/fan*_label; do
      [ -e "$lf" ] || continue
      [ "$(cat "$lf" 2>/dev/null)" = "gpu_fan" ] && { echo "${lf%_label}_input"; return 0; }
    done
  done
  # Apple (MacBookPro11,4 and friends): applesmc is a legacy-style driver. It
  # registers a BARE hwmon node — /sys/class/hwmon/hwmonN has no name and no
  # fan*_input at all — and hangs every attribute off the platform device
  # instead. The generic hwmon glob below therefore matches nothing on a Mac
  # and the tile showed a permanent N/A. Take fan1 (Apple labels them "Left
  # side"/"Right side"; neither is a GPU fan, this machine has no dGPU).
  for f in /sys/devices/platform/applesmc.*/fan1_input; do
    [ -r "$f" ] && { echo "$f"; return 0; }
  done
  # Fallback: first readable fan input from ANY hwmon (desktop SuperIO chips
  # like nct6775, dGPU fans, …). Skip stopped/absent fans reporting 0 so a
  # populated-but-idle header doesn't shadow a real spinning fan elsewhere.
  # Gauge scale still uses FAN_MAX (GPU_FAN_MAX env to calibrate per machine).
  for f in /sys/class/hwmon/hwmon*/fan*_input; do
    [ -r "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null || echo 0)" -gt 0 ] && { echo "$f"; return 0; }
  done
  return 1
}
resolve_cputemp() {
  local h lf tctl=""
  for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "coretemp" ] || continue
    for lf in "$h"/temp*_label; do
      [ -e "$lf" ] || continue
      case "$(cat "$lf" 2>/dev/null)" in Package*) echo "${lf%_label}_input"; return 0;; esac
    done
  done
  # AMD: k10temp. Prefer Tdie (true die temp, present on some SKUs) over Tctl
  # (control temp — can carry a platform offset, but is all the AZW SER9 has).
  for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "k10temp" ] || continue
    for lf in "$h"/temp*_label; do
      [ -e "$lf" ] || continue
      case "$(cat "$lf" 2>/dev/null)" in
        Tdie) echo "${lf%_label}_input"; return 0;;
        Tctl) tctl="${lf%_label}_input";;
      esac
    done
  done
  [ -n "$tctl" ] && { echo "$tctl"; return 0; }
  return 1
}

resolve_amdgpu_temp() { # amdgpu hwmon 'edge' sensor (APUs and dGPUs both expose it)
  local h lf
  for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat "$h/name" 2>/dev/null)" = "amdgpu" ] || continue
    for lf in "$h"/temp*_label; do
      [ -e "$lf" ] || continue
      [ "$(cat "$lf" 2>/dev/null)" = "edge" ] && { echo "${lf%_label}_input"; return 0; }
    done
  done
  return 1
}

resolve_i915() { # Intel integrated graphics: the drm card dir carrying gt_*_freq_mhz
  local c
  for c in /sys/class/drm/card*; do
    [ -r "$c/gt_act_freq_mhz" ] && { echo "$c"; return 0; }
  done
  return 1
}

gauge() {
  local pct=$1 width=${2:-12} filled i full="" empty=""
  filled=$(( (pct * width + 50) / 100 ))
  (( filled > width )) && filled=$width; (( filled < 0 )) && filled=0
  for ((i=0; i<filled; i++)); do full+="█"; done
  for ((i=filled; i<width; i++)); do empty+="░"; done
  printf '%s[%s%s%s%s]%s' "$D" "$A" "$full" "$D" "$empty" "$R"
}
# Borderless meter sharing the gauge/vbar family glyphs+tiers: █ fill ($A) then ░ track ($D).
sgauge() {
  local pct=$1 width=${2:-14} filled i full="" empty=""
  filled=$(( (pct * width + 50) / 100 )); (( filled > width )) && filled=$width; (( filled < 0 )) && filled=0
  (( pct > 0 && filled < 1 )) && filled=1   # always show at least one cell for nonzero usage
  for ((i=0; i<filled; i++)); do full+="█"; done
  for ((i=filled; i<width; i++)); do empty+="░"; done
  printf '%s%s%s%s%s' "$A" "$full" "$D" "$empty" "$R"
}
# Horizontal metric row (no indent): label, gauge, percent, optional note.
hrow() { printf '%s%-4s%s %s %s%3s%%%s %s%s%s' \
  "$D" "$1" "$R" "$(gauge "$2" "$HGW")" "$P" "$2" "$R" "$D" "${3:-}" "$R"; }
# One row (0=top) of a VBH-tall vertical bar for percent $1, VBW cells wide.
vbar_row() {
  local pct=$1 r=$2 w=${3:-$VBW} filled i cells="" col ch
  filled=$(( (pct * VBH + 50) / 100 )); (( filled > VBH )) && filled=$VBH; (( filled < 0 )) && filled=0
  if (( r >= VBH - filled )); then col="$A"; ch="█"; else col="$D"; ch="░"; fi
  for ((i=0; i<w; i++)); do cells+="$ch"; done
  printf '%s│%s%s%s│%s' "$D" "$col" "$cells" "$D" "$R"
}
# Three ascending signal bars for percent $1 (lit=accent, unlit=dim).
sigbars() {
  local pct=$1 lit i out="" g=("▃" "▅" "▇")
  lit=$(( (pct * 3 + 99) / 100 )); (( lit > 3 )) && lit=3; (( lit < 0 )) && lit=0
  # lit bars rise at $A; empty slots reuse the gauges' own ░ track glyph at $D, so EVERY background
  # track in the tile is byte-identical (a dense ▇ can't be color-dimmed to match a sparse ░ across fonts)
  for ((i=0; i<3; i++)); do (( i < lit )) && out+="$A${g[i]}" || out+="$D░"; done
  printf '%s%s' "$out" "$R"
}
# Human byte-rate from a byte delta ($1) over an interval in seconds ($2).
# Compact: <10 keeps one decimal (8.1M), else integer (82M, 1023K) -> max 5 chars.
fmt_rate() { awk -v d="$1" -v i="$2" 'BEGIN{
  v=(i>0)?d/i:0; u="B"
  if(v>=1073741824){v/=1073741824;u="G"} else if(v>=1048576){v/=1048576;u="M"}
  else if(v>=1024){v/=1024;u="K"}
  if(u=="B") printf "%d%s", v, u;
  else if(v<10) printf "%.1f%s", v, u;
  else printf "%.0f%s", v, u
}'; }

strip_ansi() { local s=$1 re=$'\e\[[0-9;?]*[a-zA-Z]'; while [[ $s =~ $re ]]; do s=${s//"${BASH_REMATCH[0]}"/}; done; REPLY=$s; }

draw() {
  local -n arr=$1
  local rows cols top=0 left=0 maxw=0 i pad
  if ! read -r rows cols < <(stty size </dev/tty 2>/dev/null); then rows=24; cols=80; fi
  if (( CENTER )); then
    for i in "${arr[@]}"; do strip_ansi "$i"; (( ${#REPLY} > maxw )) && maxw=${#REPLY}; done
    left=$(( (cols - maxw) / 2 )); (( left < 0 )) && left=0
    top=$(( (rows - ${#arr[@]}) / 2 )); (( top < 0 )) && top=0
  fi
  printf -v pad '%*s' "$left" ''
  printf '%s' "$HOME"
  for ((i=0; i<top; i++)); do printf '%s\n' "$EOL"; done
  for i in "${arr[@]}"; do printf '%s%s%s\n' "$pad" "$i" "$EOL"; done
  printf '%s' "$CLREOS"
}

read_cpu() { local a b c d e f g rest; read -r _ a b c d e f g rest < /proc/stat; _cidle=$(( d + e )); _ctotal=$(( a + b + c + d + e + f + g )); }

FANPATH=$(resolve_fan); CPUTEMP=$(resolve_cputemp)
# AMD GPU fallback sources (used when nvidia-smi yields nothing below)
AMDGPU_TEMP=$(resolve_amdgpu_temp)
AMDGPU_BUSY=""; for f in /sys/class/drm/card*/device/gpu_busy_percent; do [ -r "$f" ] && { AMDGPU_BUSY=$f; break; }; done
# Intel iGPU fallback (last resort — only if there is no nvidia/amd GPU)
I915_DIR=$(resolve_i915 || true)
I915_MIN=0; I915_MAX=0; I915_RC6=""; prev_rc6=0; prev_cs=0
if [ -n "${I915_DIR:-}" ]; then
  I915_MIN=$(cat "$I915_DIR/gt_min_freq_mhz" 2>/dev/null || echo 0)
  I915_MAX=$(cat "$I915_DIR/gt_max_freq_mhz" 2>/dev/null || echo 0)
  # RC6 = the render engine's deep-idle power state. Time spent OUT of it is a
  # real measurement of GPU activity, unlike the clock (which sits pinned at
  # its 200MHz floor through all light compositor work and reads as a flat 0%).
  for _f in "$I915_DIR/power/rc6_residency_ms" "$I915_DIR/gt/gt0/rc6_residency_ms"; do
    [ -r "$_f" ] && { I915_RC6=$_f; break; }
  done
  if [ -n "$I915_RC6" ]; then
    prev_rc6=$(cat "$I915_RC6" 2>/dev/null || echo 0)
    read -r _up _ < /proc/uptime; prev_cs=${_up/./}
  fi
fi
WIFI_IF=""; for d in /sys/class/net/*/wireless; do [ -e "$d" ] && { WIFI_IF=$(basename "$(dirname "$d")"); break; }; done
RXP=0; TXP=0
if [ -n "$WIFI_IF" ]; then
  RXP=$(cat "/sys/class/net/$WIFI_IF/statistics/rx_bytes" 2>/dev/null || echo 0)
  TXP=$(cat "/sys/class/net/$WIFI_IF/statistics/tx_bytes" 2>/dev/null || echo 0)
fi
read_cpu; prev_total=$_ctotal; prev_idle=$_cidle
wsig=0; wstatus="down"; ssid="?"; preset=0; wssid=0; help=0; wifi_tick=99   # caches; preset 0=disk,1=default,2=gpu; wssid toggles SSID in wifi row; help overlay
lspeed=0; drate="0B"; dlast="0B"       # link speed + download rate (dlast = last non-zero)
printf '%s%s' "$HIDE" "$CLR"
sleep "$INTERVAL"

while :; do
  # CPU
  read_cpu
  dt=$(( _ctotal - prev_total )); di=$(( _cidle - prev_idle ))
  prev_total=$_ctotal; prev_idle=$_cidle
  cpu=$(( dt > 0 ? (100 * (dt - di) + dt/2) / dt : 0 ))
  ctemp="--"; [ -n "${CPUTEMP:-}" ] && [ -r "$CPUTEMP" ] && ctemp=$(( $(cat "$CPUTEMP") / 1000 ))
  # MEM
  mt=$(awk '/^MemTotal:/{print $2}' /proc/meminfo); ma=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
  mused=$(( mt - ma )); mpct=$(( mt > 0 ? (100 * mused + mt/2) / mt : 0 ))
  memnote=$(awk -v u="$mused" -v t="$mt" 'BEGIN{printf " %.1f/%.0fG", u/1048576, t/1048576}')
  # GPU + FAN
  gutil="--"; gtemp="--"; gpwr="--"; gclk="--"
  if read -r line < <(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,power.draw,clocks.gr --format=csv,noheader,nounits 2>/dev/null); then
    IFS=',' read -r gutil gtemp gpwr gclk <<<"$line"
    gutil=${gutil// /}; gtemp=${gtemp// /}; gpwr=${gpwr// /}; gclk=${gclk// /}
  elif [ -n "${AMDGPU_BUSY:-}" ] || [ -n "${AMDGPU_TEMP:-}" ]; then
    # AMD (APU or dGPU): utilisation from drm sysfs, temp from the amdgpu
    # hwmon edge sensor. No pwr/clk here — those stay '--' in the gpu preset.
    [ -n "${AMDGPU_BUSY:-}" ] && gutil=$(cat "$AMDGPU_BUSY" 2>/dev/null)
    [ -n "${AMDGPU_TEMP:-}" ] && [ -r "$AMDGPU_TEMP" ] && gtemp=$(( $(cat "$AMDGPU_TEMP") / 1000 ))
  elif [ -n "${I915_DIR:-}" ]; then
    # Intel integrated (MacBook Iris Pro, NUCs, …). Two honest caveats:
    #  * There is no engine busy-percent in sysfs (that needs the i915 PMU,
    #    what intel_gpu_top opens — far too heavy for a poll loop). RC6
    #    residency is the next best thing and IS a real measurement: the
    #    fraction of wall time the render engine was awake rather than in its
    #    deep-idle state. It reads "GPU awake", not "GPU working hard".
    #  * The iGPU is on the CPU die and has no separate thermal sensor, so the
    #    package temp IS its temp — the same number the cpu row shows.
    gclk=$(cat "$I915_DIR/gt_act_freq_mhz" 2>/dev/null)
    if [ -n "$I915_RC6" ]; then
      # busy% = share of wall time the GPU was NOT in RC6. 10# on both reads:
      # /proc/uptime with a small hundredths value ("0.08") would otherwise be
      # parsed as octal and abort the frame.
      now_rc6=$(cat "$I915_RC6" 2>/dev/null || echo 0)
      read -r _up _ < /proc/uptime; now_cs=${_up/./}
      d_wall=$(( (10#$now_cs - 10#$prev_cs) * 10 ))
      d_rc6=$(( now_rc6 - prev_rc6 ))
      prev_rc6=$now_rc6; prev_cs=$now_cs
      if (( d_wall > 0 && d_rc6 >= 0 )); then
        gutil=$(( 100 - (d_rc6 * 100 / d_wall) ))
        (( gutil < 0 )) && gutil=0; (( gutil > 100 )) && gutil=100
      fi
    elif [[ "$gclk" =~ ^[0-9]+$ ]] && (( I915_MAX > I915_MIN )); then
      # No RC6 counter: fall back to where the clock sits in its range. Only a
      # proxy — it stays at 0% for light work that never lifts the clock.
      gutil=$(( (gclk - I915_MIN) * 100 / (I915_MAX - I915_MIN) ))
      (( gutil < 0 )) && gutil=0; (( gutil > 100 )) && gutil=100
    fi
    [ -n "${CPUTEMP:-}" ] && [ -r "$CPUTEMP" ] && gtemp=$(( $(cat "$CPUTEMP") / 1000 ))
  fi
  [[ "$gutil" =~ ^[0-9]+$ ]] && gpct=$gutil || gpct=0
  rpm=""; fanpct=0
  [ -n "${FANPATH:-}" ] && [ -r "$FANPATH" ] || FANPATH=$(resolve_fan)
  [ -n "${FANPATH:-}" ] && rpm=$(cat "$FANPATH" 2>/dev/null)
  if [[ "$rpm" =~ ^[0-9]+$ ]]; then fanpct=$(( rpm * 100 / FAN_MAX )); (( fanpct > 100 )) && fanpct=100; rpm_disp="$rpm rpm"; fanshort="$rpm"; else rpm_disp="N/A"; fanshort="N/A"; fi
  # BATTERY
  bcap="--"; bstat="?"; bnote=""
  for b in /sys/class/power_supply/BAT*; do
    [ -e "$b/capacity" ] || continue
    bcap=$(cat "$b/capacity" 2>/dev/null); bstat=$(cat "$b/status" 2>/dev/null)
    pw=$(cat "$b/power_now" 2>/dev/null || echo 0)
    [[ "$pw" =~ ^[0-9]+$ ]] && (( pw > 0 )) && bnote=$(awk -v p="$pw" 'BEGIN{printf " %.1fW", p/1000000}')
    break
  done
  ac=""; for a in /sys/class/power_supply/A{C,DP}*; do [ -e "$a/online" ] && { [ "$(cat $a/online)" = 1 ] && ac="AC" || ac="BAT"; break; }; done

  # WIFI status — from sysfs operstate every frame (stable; won't flap on nmcli hiccups).
  wstatus="down"; wup=0
  if [ -n "$WIFI_IF" ] && [ "$(cat "/sys/class/net/$WIFI_IF/operstate" 2>/dev/null)" = "up" ]; then
    wstatus="connected"; wup=1
  fi
  # WIFI signal + link speed — throttled nmcli; KEEP last values if a query fails.
  if (( wifi_tick >= 5 )); then
    wifi_tick=0
    wline=$(timeout 2 nmcli -t -f ACTIVE,SSID,SIGNAL dev wifi 2>/dev/null | grep -m1 '^yes:')
    if [ -n "$wline" ]; then rest=${wline#yes:}; v=${rest##*:}; s=${rest%:*}
      [[ "$v" =~ ^[0-9]+$ ]] && wsig=$v; [ -n "$s" ] && ssid=$s; fi
    spd=$(timeout 2 nmcli -t -f CAPABILITIES.SPEED dev show "${WIFI_IF:-wlan0}" 2>/dev/null)
    spd=${spd#*:}; spd=${spd%% *}                 # "CAPABILITIES.SPEED:648 Mb/s" -> "648"
    [[ "$spd" =~ ^[0-9]+$ ]] && lspeed=$spd
  else (( wifi_tick++ )); fi
  (( wup )) || wsig=0   # empty bars only when truly down
  # NET download rate — every frame from rx byte deltas; cache last non-zero, dim when idle.
  delta=0
  if [ -n "$WIFI_IF" ]; then
    rxn=$(cat "/sys/class/net/$WIFI_IF/statistics/rx_bytes" 2>/dev/null || echo "$RXP")
    delta=$(( rxn - RXP )); RXP=$rxn; (( delta < 0 )) && delta=0
  fi
  if (( wup )); then
    if (( delta > 0 )); then drate=$(fmt_rate "$delta" "$INTERVAL"); dlast=$drate
    else drate=$dlast; fi                     # idle: keep last speed (still bright)
    lshow=$lspeed; wcol="$P"
  else
    drate="0B"; lshow=0; wcol="$D"            # only truly down dims both to zero
  fi
  # status text: default word, or (wssid toggle) the SSID name when connected
  if (( wup )); then (( wssid )) && wshow="${ssid:0:SW}" || wshow="connected"
  else (( wssid )) && wshow="disconnected" || wshow="down"; fi

  # Disk preset (default): bottom row shows a text disk line (like the bat line) instead of bat.
  if (( preset == 0 )); then
    read -r du ds dp < <(df -B1 --output=used,size,pcent "$DISK" 2>/dev/null | tail -1)
    dpct=${dp//[!0-9]/}; [[ "$dpct" =~ ^[0-9]+$ ]] || dpct=0
    dnote=$(awk -v u="${du:-0}" -v t="${ds:-0}" 'function h(x,  g){g=1073741824; if(x>=1024*g) return sprintf("%.1fT",x/(1024*g)); return sprintf("%.0fG",x/g)} BEGIN{if(t>0) printf "%s/%s", h(u), h(t)}')
    batline="${D}disk${R} $(sgauge "$dpct" 14) ${P}$(printf '%3s' "$dpct")%${R}  ${D}${dnote}${R}"
  else
    batline="${D}bat ${R}  ${P}${bcap}%${R}  ${D}${bstat}${ac:+ · $ac}${bnote}${R}"
  fi
  # Middle column: horizontal rows; flanked by two vertical bars (gpu left, fan right).
  mid=(
    "${D}wifi${R} $(sigbars "$wsig") ${wcol}$(printf '%4s' "$lshow")Mb${R} ${D}·${R} ${wcol}▼ $(printf '%-5s' "$drate")${R}${D}· $(printf "%-${SW}s" "$wshow")${R}"
    ""
    "$(hrow cpu "$cpu" " ${ctemp}°C")"
    ""
    "$(hrow mem "$mpct" "$memnote")"
    ""
  )
  VBH=${#mid[@]}   # both vertical bars span the middle column
  MIDW=0           # widest middle row (incl. the bat line on the bottom row)
  for m in "${mid[@]}" "$batline"; do strip_ansi "$m"; (( ${#REPLY} > MIDW )) && MIDW=${#REPLY}; done
  glabel="$(printf '%s%-6s%s' "$P" " gpu" "$R")"; flabel="$(printf '%s%-6s%s' "$P" " fan" "$R")"
  lines=( "  ${glabel}${GAP}$(printf '%*s' "$MIDW" '')${GAP}${flabel}" )
  for ((r=0; r<VBH; r++)); do
    strip_ansi "${mid[r]}"; printf -v mp '%*s' $(( MIDW - ${#REPLY} )) ''
    lines+=( "  $(vbar_row "$gpct" "$r")${GAP}${mid[r]}${mp}${GAP}$(vbar_row "$fanpct" "$r")" )
  done
  strip_ansi "$batline"; printf -v bp '%*s' $(( MIDW - ${#REPLY} )) ''
  lines+=( "  $(printf '%s%-6s%s' "$P" " ${gtemp}°C " "$R")${GAP}${batline}${bp}${GAP}$(printf '%s%-6s%s' "$P" " ${fanshort}" "$R")" )
  # Preset 2: GPU-focus view (fan + gpu bars + pwr/clk), like the standalone gpu-fan-tile.
  if (( preset == 2 )); then
    lines=(
      "  ${D}fan${R}   ${P}${rpm_disp}${R}"
      "  $(gauge "$fanpct" 16) ${P}$(printf '%3s' "$fanpct")%${R}"
      ""
      "  ${D}gpu${R}   ${P}${gtemp}°C${R}"
      "  $(gauge "$gpct" 16) ${P}$(printf '%3s' "$gutil")%${R}"
      ""
      "  ${D}pwr${R}   ${P}${gpwr}W${R}   ${D}clk${R} ${P}${gclk}MHz${R}"
    )
  fi
  # Help overlay replaces the tile while active.
  if (( help )); then
    lines=(
      "  ${P}sys-tile${R} ${D}keys${R}"
      ""
      "  ${P}q${R}   ${D}quit${R}"
      "  ${P}p${R}   ${D}cycle preset (disk / default / gpu)${R}"
      "  ${P}w${R}   ${D}toggle wifi SSID${R}"
      "  ${P}c${R}   ${D}cycle theme (custom / ride-accent / ride-green)${R}"
      "  ${P}h${R}   ${D}this help${R}"
      ""
      "  ${D}press any key to close${R}"
    )
  fi
  draw lines
  # Frame delay that also reads a keypress (no Enter needed, not echoed).
  if read -rsn1 -t "$INTERVAL" key 2>/dev/null; then
    case "$key" in q|Q) exit 0 ;; esac        # q always quits
    if (( help )); then help=0                 # any other key closes help
    else
      case "$key" in
        p|P) preset=$(( (preset + 1) % 3 )) ;; # cycle: disk -> default -> GPU view
        w|W) wssid=$(( wssid ^ 1 )) ;;         # toggle SSID name in wifi row
        c|C) mode=$(( (mode + 1) % 3 )); set_palette ;; # cycle: custom -> ride-accent -> ride-green
        h|H) help=1 ;;                         # show help
      esac
    fi
  fi
done
